<%@ Master Language="C#" AutoEventWireup="true" CodeFile="CashierSite.master.cs" Inherits="CashierSiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Azure Cashier</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="Content/cashier.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="cashier-body">
    <form id="cashierForm" runat="server">
        <div class="cashier-shell">

            <aside class="cashier-sidebar">
                <a href="Dashboard.aspx" class="cashier-logo">
                    Azure
                </a>

                <nav class="cashier-nav">
                    <a href="Dashboard.aspx" class="nav-item <%= ActiveClass("Dashboard.aspx") %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                        Dashboard
                    </a>
                    <a href="Menu.aspx" class="nav-item <%= ActiveClass("Menu.aspx") %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round"/></svg>
                        Menu
                    </a>
                    <a href="Orders.aspx" class="nav-item <%= ActiveClass("Orders.aspx") %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3M8 10h8M8 14h5" stroke-linecap="round"/></svg>
                        Orders
                    </a>
                    <span class="nav-item nav-static">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v3M16 4v3" stroke-linecap="round"/></svg>
                        Table
                    </span>
                    <span class="nav-item nav-static">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18" stroke-linecap="round"/><circle cx="16" cy="14" r="1.4"/></svg>
                        Accounting
                    </span>
                    <span class="nav-item nav-static">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 13.5a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V19.9a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.11-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H4.1a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.56-1.11 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H10.2a1.7 1.7 0 0 0 1.03-1.56V4.1a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V10.2a1.7 1.7 0 0 0 1.56 1.03H19.9a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.56 1.03z"/></svg>
                        Settings
                    </span>
                </nav>

                <div class="cashier-user">
                    <div class="user-avatar">C</div>
                    <div>
                        <div class="user-name">Cashier</div>
                        <div class="user-role">On Shift</div>
                    </div>
                </div>
            </aside>

            <main class="cashier-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>

        </div>
    </form>
</body>
</html>
